# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env / secrets — never commit real tokens
.env
.env.*
!.env.example
*.pem
*.token
secrets/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent scratch
agent-tools/

# Local Odoo 19 Enterprise install (large / private)
odoo19/community/
odoo19/enterprise/
odoo19/venv/
odoo19/filestore/
odoo19/logs/
**/__pycache__/

# Odoo Enterprise source (large, do not commit)
odoo19e/src/
